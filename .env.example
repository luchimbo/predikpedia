# Preferido: OpenRouter. Da acceso a múltiples modelos con una capa compatible con OpenAI.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Alternativa: Gemini directo
GEMINI_API_KEY=your_gemini_api_key_here

# Límite de tokens para la corrida
QUOTA_LIMIT=500000

# Modelo a testear
MODEL_NAME=google/gemini-2.5-pro
