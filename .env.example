# Router: local (default, 24/7 with OpenRouter fallback after 60s), openrouter or schedule.
LLM_PROVIDER=local
# Optional: only used in schedule mode.
LLM_SCHEDULE_TIMEZONE=America/Argentina/Buenos_Aires
LLM_LOCAL_START=09:30
LLM_LOCAL_END=17:30

# Local agents on the LAN call Ollama directly. Render receives a trycloudflare /v1 URL.
LLM_LOCAL_BASE_URL=http://192.168.1.104:11434/v1
LLM_LOCAL_MODEL=qwen2.5:32b
LLM_LOCAL_API_KEY=local-relay-or-ollama-token

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
QUOTA_LIMIT=500000

# Public evidence preparation: local app + Ollama only, no paid search API.
RESEARCH_MAX_ROUNDS=2
RESEARCH_MAX_QUERIES=8
RESEARCH_MAX_DOCUMENTS=20
